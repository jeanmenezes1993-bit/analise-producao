# Copie este arquivo para ".env" e preencha com as credenciais de acesso.
# O arquivo .env não vai para o GitHub (está no .gitignore).

VITE_LOGIN_USER=usuario_aqui
# E-mail do usuário criado no Supabase Auth (Authentication > Users)
# que corresponde a este login. A senha em si NÃO fica aqui — ela é
# validada pelo próprio Supabase no momento do login.
VITE_LOGIN_EMAIL=email_aqui
